# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# Precedence: non-empty value here > fresh Windows user environment > inherited environment.

# --- Knowledge (REQUIRED) -------------------------------------------------
# Folders of .md notes Jarvis indexes. Separate several with ";".
NOTES_PATHS=C:\path\to\your\notes;C:\path\to\more\notes

# Jarvis's OWN notes folder: the only place he WRITES. Say "remember that ..." and
# the fact is saved here as a .md file, linked into the galaxy, and re-indexed
# with everything else (it is indexed automatically; no need to repeat it above).
# Windows: C:\Users\you\Documents\Jarvis Notes     Mac: ~/Documents/Jarvis_Notes
# Created if missing.
JARVIS_NOTES_DIR=C:\path\to\Jarvis Notes

# --- Web search tool (optional) -------------------------------------------
# Only needed if Chrome is not in a standard location. Full path to chrome.exe.
CHROME_PATH=

# --- Jira + Confluence via the mcp-atlassian MCP server (optional) ---------
# Needs `uvx` (from uv) on PATH. Jarvis starts the server itself on first use,
# read-only (see "allow" under mcp_servers in config.json).
# Atlassian data is only ever given to a brain running on this machine.
#
# Jira. Server/Data Center: URL + personal access token (PAT).
JIRA_URL=https://jira.your-company.example.com
JIRA_PERSONAL_TOKEN=
# Jira Cloud instead: URL (https://your-site.atlassian.net) + email + API token.
JIRA_USERNAME=
JIRA_API_TOKEN=
# Set to false only for an internal CA you cannot trust-store.
JIRA_SSL_VERIFY=true
#
# Confluence (same pattern; leave CONFLUENCE_URL empty to switch Confluence off).
CONFLUENCE_URL=https://confluence.your-company.example.com
CONFLUENCE_PERSONAL_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SSL_VERIFY=true

# --- Cloud brain (optional) -----------------------------------------------
# Referenced from config.json as "${CLAUDE_API_KEY}". Leave empty to stay
# fully local; Jarvis then reports the cloud as unplugged.
CLAUDE_API_KEY=

# --- Add new tool credentials below, one per line, and document them here ---
# Example: SOME_TOOL_API_KEY=
